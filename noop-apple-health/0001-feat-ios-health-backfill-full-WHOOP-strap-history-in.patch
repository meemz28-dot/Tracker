diff --git a/Packages/StrandImport/Sources/StrandImport/HealthWriteback.swift b/Packages/StrandImport/Sources/StrandImport/HealthWriteback.swift
index fd8d5d0..d576e13 100644
--- a/Packages/StrandImport/Sources/StrandImport/HealthWriteback.swift
+++ b/Packages/StrandImport/Sources/StrandImport/HealthWriteback.swift
@@ -247,4 +247,60 @@ public enum HealthWriteback {
     public static func strandedSweepResult(swept: Set<String>, succeededThisRun: Set<String>) -> Set<String> {
         swept.union(succeededThisRun)
     }
+
+    // MARK: - History backfill windows
+    //
+    // The routine write-back covers only the trailing 14 days. A user who imports years of WHOOP CSV
+    // history (or has months of strap data from before they granted Health access) needs a one-shot
+    // backfill that pushes the WHOLE history into Apple Health. Doing that as one pass would blow the
+    // per-read limits (`sleepSessions(limit: 200)`, `workoutReadLimit`) and build one enormous
+    // `HKHealthStore.save` batch, so the bridge walks the range in fixed chunks instead.
+
+    /// One backfill chunk, `[fromTs, toTs)` in unix seconds.
+    public struct BackfillWindow: Equatable, Sendable {
+        public let fromTs: Int
+        public let toTs: Int
+        public init(fromTs: Int, toTs: Int) { self.fromTs = fromTs; self.toTs = toTs }
+    }
+
+    /// Default chunk size. 30 nights stays well under the 200-session sleep read limit (naps
+    /// included) and the 500-workout read limit, and keeps each HealthKit save batch small.
+    public static let backfillChunkDays = 30
+
+    /// Split `[fromTs, toTs)` into chunks of `chunkDays`, NEWEST FIRST so the most relevant history
+    /// lands in Health before older data if the pass is interrupted.
+    ///
+    /// Interior boundaries sit at LOCAL NOON (`utcOffsetSec` = the zone's offset from GMT): a night is
+    /// queried by its start time, and no sleep starts at midday, so a night and its naps never straddle
+    /// two chunks. That matters because the sleep write merges a night's fragments into ONE Health entry
+    /// keyed by the earliest fragment, and a split would write the halves as two entries. The outer edges
+    /// are kept exactly as given. An empty or inverted range yields no windows.
+    public static func backfillWindows(fromTs: Int, toTs: Int, chunkDays: Int = backfillChunkDays,
+                                       utcOffsetSec: Int) -> [BackfillWindow] {
+        guard toTs > fromTs, chunkDays > 0 else { return [] }
+        let day = 86_400
+        let span = chunkDays * day
+        // The last local noon at or before toTs, in UTC seconds.
+        let localTo = toTs + utcOffsetSec
+        var localNoon = localTo - ((localTo % day) + day) % day + day / 2
+        if localNoon > localTo { localNoon -= day }
+        var boundary = localNoon - utcOffsetSec
+        var windows: [BackfillWindow] = []
+        var upper = toTs
+        // First chunk may be shorter (up to the most recent noon); later chunks are exactly `span`.
+        if boundary <= fromTs {
+            return [BackfillWindow(fromTs: fromTs, toTs: toTs)]
+        }
+        if boundary < upper {
+            windows.append(BackfillWindow(fromTs: boundary, toTs: upper))
+            upper = boundary
+        }
+        while upper > fromTs {
+            boundary = upper - span
+            let lower = max(boundary, fromTs)
+            windows.append(BackfillWindow(fromTs: lower, toTs: upper))
+            upper = lower
+        }
+        return windows
+    }
 }
diff --git a/Packages/StrandImport/Tests/StrandImportTests/HealthWritebackBackfillTests.swift b/Packages/StrandImport/Tests/StrandImportTests/HealthWritebackBackfillTests.swift
new file mode 100644
index 0000000..de2eb2b
--- /dev/null
+++ b/Packages/StrandImport/Tests/StrandImportTests/HealthWritebackBackfillTests.swift
@@ -0,0 +1,59 @@
+import XCTest
+@testable import StrandImport
+
+final class HealthWritebackBackfillTests: XCTestCase {
+
+    private let day = 86_400
+
+    /// Windows must tile the range exactly: contiguous, newest first, no gaps or overlaps.
+    private func assertTiles(_ w: [HealthWriteback.BackfillWindow], from: Int, to: Int,
+                             file: StaticString = #filePath, line: UInt = #line) {
+        XCTAssertFalse(w.isEmpty, file: file, line: line)
+        XCTAssertEqual(w.first?.toTs, to, file: file, line: line)
+        XCTAssertEqual(w.last?.fromTs, from, file: file, line: line)
+        for (a, b) in zip(w, w.dropFirst()) {
+            XCTAssertEqual(a.fromTs, b.toTs, "gap/overlap between chunks", file: file, line: line)
+            XCTAssertLessThan(b.fromTs, b.toTs, file: file, line: line)
+        }
+    }
+
+    func testEmptyAndInvertedRangesYieldNothing() {
+        XCTAssertEqual(HealthWriteback.backfillWindows(fromTs: 100, toTs: 100, utcOffsetSec: 0), [])
+        XCTAssertEqual(HealthWriteback.backfillWindows(fromTs: 200, toTs: 100, utcOffsetSec: 0), [])
+        XCTAssertEqual(HealthWriteback.backfillWindows(fromTs: 0, toTs: 100, chunkDays: 0, utcOffsetSec: 0), [])
+    }
+
+    func testOneYearTilesIntoThirtyDayChunksAtLocalNoon() {
+        // 2026-11-20 15:00 Dubai (UTC+4) = 11:00Z.
+        let offset = 4 * 3600
+        let to = 1_795_132_800 + 11 * 3600   // 2026-11-20T11:00:00Z
+        let from = to - 365 * day
+        let w = HealthWriteback.backfillWindows(fromTs: from, toTs: to, utcOffsetSec: offset)
+        assertTiles(w, from: from, to: to)
+        // Every interior boundary is local noon.
+        for b in w.dropLast().map(\.fromTs) {
+            XCTAssertEqual(((b + offset) % day + day) % day, day / 2, "boundary \(b) is not local noon")
+        }
+        // Interior chunks are exactly 30 days.
+        for c in w.dropFirst().dropLast() { XCTAssertEqual(c.toTs - c.fromTs, 30 * day) }
+        XCTAssertLessThanOrEqual(w.count, 14)
+    }
+
+    func testRangeShorterThanToNoonIsOneWindow() {
+        // 2026-11-20 13:00Z..14:00Z, offset 0 → the last noon (12:00Z) is before `from`.
+        let from = 1_795_132_800 + 13 * 3600
+        let w = HealthWriteback.backfillWindows(fromTs: from, toTs: from + 3600, utcOffsetSec: 0)
+        XCTAssertEqual(w, [.init(fromTs: from, toTs: from + 3600)])
+    }
+
+    func testNegativeOffsetZone() {
+        let offset = -8 * 3600
+        let to = 1_795_132_800 + 3 * 3600
+        let from = to - 100 * day
+        let w = HealthWriteback.backfillWindows(fromTs: from, toTs: to, utcOffsetSec: offset)
+        assertTiles(w, from: from, to: to)
+        for b in w.dropLast().map(\.fromTs) {
+            XCTAssertEqual(((b + offset) % day + day) % day, day / 2)
+        }
+    }
+}
