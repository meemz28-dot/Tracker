+
     #if os(iOS)
     @ViewBuilder
     private var liveSyncCard: some View {
@@ -467,6 +511,8 @@ struct AppleHealthView: View {
                     .buttonStyle(.bordered)
                     .tint(StrandPalette.metricCyan)
                     .disabled(health.syncing)
+
+                    historyBackfillControls
                 }
 
                 if let err = health.lastError {
diff --git a/StrandiOS/Health/HealthKitBridge.swift b/StrandiOS/Health/HealthKitBridge.swift
index cb844c5..b9e528e 100644
--- a/StrandiOS/Health/HealthKitBridge.swift
+++ b/StrandiOS/Health/HealthKitBridge.swift
@@ -31,6 +31,10 @@ final class HealthKitBridge: ObservableObject {
     @Published private(set) var auth: AuthState = .unknown
     @Published private(set) var lastSync: Date?
     @Published private(set) var syncing = false
+    /// History backfill progress (0...1) while `backfillHistory` runs, nil otherwise.
+    @Published private(set) var backfillProgress: Double?
+    /// Outcome line of the last history backfill, for the Apple Health card.
