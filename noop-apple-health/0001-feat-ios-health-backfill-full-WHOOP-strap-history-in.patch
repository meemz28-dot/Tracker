     }
 
+    // MARK: - History backfill (WHOOP history → Health)
+
+    /// Push NOOP's WHOLE history — imported WHOOP CSV rows (`physiological_cycles`, `sleeps`,
+    /// `workouts`) and strap-computed rows alike — into Apple Health, not just the trailing 14 days the
+    /// routine `writeBack` covers.
+    ///
+    /// Walks `[now - days, now)` in `HealthWriteback.backfillWindows` chunks, newest first, and runs the
+    /// SAME per-feature writers as the routine pass for each chunk: nightly vitals (RHR, HRV SDNN, SpO₂,
+    /// respiratory rate), sleep with stages, and workouts. Because those writers delete-then-write on
+    /// the deterministic `noop:<kind>:<identity>` keys, the backfill is idempotent: running it twice,
+    /// or a later routine write-back over the same days, replaces rather than duplicates.
+    ///
+    /// Deliberately NOT included: the continuous 1-minute heart-rate stream. A WHOOP CSV carries none,
+    /// and re-walking months of strap HR would bloat the Health store by ~1.4k samples/day; HR keeps its
+    /// own forward cursor in `writeHeartRate`. Not included either: the open-night hold (only the
+    /// newest chunk can contain a night still recording, and the routine pass owns that) and the #1503
+    /// stranded sweep (one-off, owned by the routine pass).
+    ///
+    /// Shares the `syncing` single-flight flag so it never interleaves with `sync`/`writeBack`.
+    /// - Parameter days: how far back to go. `nil` = everything (capped at 10 years).
+    /// - Returns: true when every chunk saved without error.
+    @discardableResult
+    func backfillHistory(days: Int?) async -> Bool {
+        refreshAuthIfPreviouslyGranted()
+        guard auth == .authorized else { return false }
+        guard !syncing else { return false }
+        syncing = true
+        backfillProgress = 0
+        defer {
+            backfillProgress = nil
+            finishHealthPass()
+        }
+        guard let whoopStore = await repo.storeHandle() else { return false }
+
+        let nowTs = Int(Date().timeIntervalSince1970)
+        let span = min(days ?? 3_650, 3_650)
+        // The trailing 2 days stay with the routine pass, which knows whether last night is still open.
+        let toTs = nowTs - 2 * 86_400
+        let fromTs = nowTs - span * 86_400
+        let windows = HealthWriteback.backfillWindows(fromTs: fromTs, toTs: toTs,
+                                                      utcOffsetSec: TimeZone.current.secondsFromGMT())
+        var failures = 0
+        var nights = 0
+        var firstError: Error?
+        for (i, w) in windows.enumerated() {
+            if Task.isCancelled { break }
+            let computed = (try? await whoopStore.sleepSessions(deviceId: computedDeviceId, from: w.fromTs,
+                                                                to: w.toTs, limit: 200)) ?? []
+            let imported = (try? await whoopStore.sleepSessions(deviceId: noopDeviceId, from: w.fromTs,
+                                                                to: w.toTs, limit: 200)) ?? []
+            var byStart: [Int: CachedSleepSession] = [:]
+            for s in computed { byStart[s.startTs] = s }
+            for s in imported { byStart[s.startTs] = s }   // imported wins, same precedence as writeBack
+            let sessions = byStart.keys.sorted().map { byStart[$0]! }
+            nights += sessions.count
+            var chunkFailed = false
+            func attempt(_ op: () async throws -> Void) async {
+                do { try await op() } catch {
+                    chunkFailed = true
+                    if firstError == nil { firstError = error }
+                }
+            }
+            await attempt { try await writeVitals(whoopStore: whoopStore, fromTs: w.fromTs, toTs: w.toTs,
+                                                  sessions: sessions) }
+            await attempt { try await writeSleep(sessions: sessions) }
+            await attempt { try await writeWorkouts(whoopStore: whoopStore, fromTs: w.fromTs, toTs: w.toTs) }
+            if chunkFailed { failures += 1 }
+            backfillProgress = Double(i + 1) / Double(max(windows.count, 1))
+        }
+        if let firstError {
+            lastError = String(localized: "Apple Health history backfill failed: \(firstError.localizedDescription)")
+            lastBackfillSummary = String(localized: "Backfill finished with errors in \(failures) of \(windows.count) chunks.")
+            return false
+        }
+        lastError = nil
+        lastBackfillSummary = String(localized: "Sent \(nights) nights plus their vitals and workouts to Apple Health.")
+        return true
+    }
+
     /// UserDefaults key for the #1503 stranded-records sweep completion set. Stores the set of
     /// type ids whose sweep delete has SUCCEEDED, so a type that was unauthorized or whose delete
     /// failed is retried on a later write-back run rather than abandoned. Per-type (not a single
@@ -951,12 +1034,11 @@ final class HealthKitBridge: ObservableObject {
     /// The nightly vitals write (the original write-back), now stamped at the day's wake time when
     /// that day has a sleep session — a real timestamp inside the night the value describes, instead
     /// of a fabricated noon. Keys are unchanged, so re-stamped samples replace their noon ancestors.
-    private func writeVitals(whoopStore: WhoopStore, days: Int, sessions: [CachedSleepSession],
+    private func writeVitals(whoopStore: WhoopStore, fromTs: Int, toTs: Int, sessions: [CachedSleepSession],
                              holdingDays: Set<String> = []) async throws {
         let cal = Calendar.current
-        let to = HealthKitBridge.dayString(Date())
-        guard let fromDate = cal.date(byAdding: .day, value: -days, to: Date()) else { return }
-        let from = HealthKitBridge.dayString(fromDate)
+        let to = HealthKitBridge.dayString(Date(timeIntervalSince1970: TimeInterval(toTs)))
+        let from = HealthKitBridge.dayString(Date(timeIntervalSince1970: TimeInterval(fromTs)))
 
         // day (of wake) → wake instant. Ascending session order means the latest wake of a day wins,
         // matching collectSleep's end-date day attribution.
